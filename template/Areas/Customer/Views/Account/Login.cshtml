@{
    ViewBag.Title = "Đăng nhập tài khoản";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-title">Login to Razer ID</div>

        <!-- KẾT NỐI TRỰC TIẾP VỚI ACCOUNTCONTROLLER / LOGIN (POST) -->
        @using (Html.BeginForm("Login", "Account", new { area = "Customer" }, FormMethod.Post, new { id = "login-form" }))
        {
            @Html.AntiForgeryToken()

            <!-- Hiển thị thông báo lỗi khi đăng nhập thất bại -->
            @Html.ValidationSummary(true, "", new { @style = "color: #dc2626; font-size: 13px; margin-bottom: 15px; text-align: center;" })

            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" id="email" name="email" class="form-input" required>
                <div id="email-error" class="error-message">Please enter a valid email address.</div>
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-input" required>
                <div id="password-error" class="error-message">Password cannot be empty.</div>
            </div>

            <div class="forgot-password">
                <a href="#">Forgot password?</a>
            </div>

            <button type="submit" class="btn-submit">Login</button>
        }

        <div class="auth-switch">
            Don't have an account yet? <a href="@Url.Action("Register", "Account")">Create account &gt;</a>
        </div>
    </div>
</div>

<style>
    .auth-wrapper {
        min-height: calc(100vh - 70px);
        display: flex;
        justify-content: center;
        align-items: center;
        background-image: url("/content/image2/5-1.jpg");
        background-size: cover;
        background-position: center;
        padding: 40px 20px;
    }

    .auth-card {
        background-color: white;
        border: 1px solid #222;
        width: 100%;
        max-width: 440px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        border-radius: 12px;
    }

    .auth-title {
        color: black;
        font-size: 22px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 30px;
        letter-spacing: 1px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 12px;
        text-transform: uppercase;
        color: #333;
        margin-bottom: 8px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .form-input {
        width: 100%;
        background-color: #fafafa;
        border: 1px solid #ccc;
        padding: 12px 16px;
        color: black;
        font-size: 14px;
        border-radius: 6px;
        outline: none;
        transition: border-color 0.2s;
    }

        .form-input:focus {
            border-color: #2563eb;
        }

    .error-message {
        color: #dc2626;
        font-size: 12px;
        margin-top: 5px;
        display: none;
    }

    .forgot-password {
        text-align: right;
        margin-bottom: 20px;
    }

        .forgot-password a {
            color: #666;
            font-size: 13px;
            text-decoration: none;
        }

            .forgot-password a:hover {
                color: #2563eb;
            }

    .btn-submit {
        width: 100%;
        background-color: black;
        color: white;
        font-weight: 700;
        text-transform: uppercase;
        padding: 14px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        letter-spacing: 1px;
        transition: background-color 0.2s;
    }

        .btn-submit:hover {
            background-color: #2563eb;
        }

    .auth-switch {
        text-align: center;
        margin-top: 24px;
        font-size: 13px;
        color: #555;
    }

        .auth-switch a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

            .auth-switch a:hover {
                text-decoration: underline;
            }
</style>