@model template.Models.User
@{
    ViewBag.Title = "Chỉnh sửa thông tin tài khoản";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="account-edit-wrapper">
    <div class="account-card">
        <h1 class="account-title">Thông tin tài khoản</h1>
        <p class="account-subtitle">Quản lý thông tin đăng nhập và bảo mật của bạn</p>

        @if (ViewBag.SuccessMessage != null)
        {
            <div style="background-color: #dcfce7; color: #15803d; padding: 10px 14px; border-radius: 6px; font-size: 14px; margin-bottom: 20px; border: 1px solid #bbf7d0;">
                @ViewBag.SuccessMessage
            </div>
        }

        @Html.ValidationSummary(true, "", new { @style = "background-color: #fee2e2; color: #dc2626; padding: 10px 14px; border-radius: 6px; font-size: 14px; margin-bottom: 20px; border: 1px solid #fecaca;" })

        @using (Html.BeginForm("Edit", "Account", new { area = "Customer" }, FormMethod.Post, new { id = "edit-account-form" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Tên đăng nhập / Username</label>
                <input type="text" class="form-input" value="@(Model != null ? Model.Username : "")" readonly style="background-color: #f3f4f6; cursor: not-allowed;">
            </div>

            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-input" value="@(Model != null ? Model.Email : "")" readonly style="background-color: #f3f4f6; cursor: not-allowed;">
            </div>

            <hr class="divider">

            <h2 class="section-title">Đổi mật khẩu</h2>

            <div class="form-group">
                <label class="form-label">Mật khẩu mới (Bỏ qua nếu không muốn đổi)</label>
                <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="Nhập mật khẩu mới (ít nhất 6 ký tự)">
            </div>

            <div class="form-action-btns">
                <button type="submit" class="btn-submit">Lưu thay đổi</button>
                <a href="@Url.Action("Logout", "Account")" class="btn-logout"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</a>
            </div>
        }
    </div>
</div>

<style>
    .account-edit-wrapper {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background-color: #f9fafb;
    }

    .account-card {
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        width: 100%;
        max-width: 520px;
        padding: 40px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        border-radius: 12px;
    }

    .account-title {
        color: #111827;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .account-subtitle {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 24px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 12px;
        text-transform: uppercase;
        color: #374151;
        margin-bottom: 6px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .form-input {
        width: 100%;
        background-color: #fff;
        border: 1px solid #d1d5db;
        padding: 12px 16px;
        color: #111827;
        font-size: 14px;
        border-radius: 6px;
        outline: none;
        transition: border-color 0.2s;
    }

        .form-input:focus {
            border-color: #2563eb;
        }

    .divider {
        border: none;
        border-top: 1px solid #e5e7eb;
        margin: 24px 0;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 16px;
    }

    .form-action-btns {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-submit {
        flex: 1;
        background-color: #2563eb;
        color: #ffffff;
        font-weight: 700;
        padding: 12px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        transition: background-color 0.2s;
    }

        .btn-submit:hover {
            background-color: #1d4ed8;
        }

    .btn-logout {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background-color: #f3f4f6;
        color: #dc2626;
        font-weight: 600;
        padding: 12px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 14px;
        border: 1px solid #e5e7eb;
        transition: background-color 0.2s;
    }

        .btn-logout:hover {
            background-color: #fee2e2;
        }
</style>