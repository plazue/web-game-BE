@model IEnumerable<template.Models.Product>
@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="category-wrap">
    <div class="page-header">
        <h1>Tất cả sản phẩm</h1>
        <p>Khám phá bộ sưu tập gaming gear chính hãng chất lượng cao</p>
    </div>

    <div class="shop-layout">
        <!-- THANH BỘ LỌC -->
        <aside class="filter-sidebar">
            <div class="filter-group">
                <div class="filter-title">Tìm kiếm</div>
                <input type="text" id="filterSearch" class="filter-search-input" placeholder="Nhập tên sản phẩm..." />
            </div>

            <!-- Thương hiệu động từ database -->
            <div class="filter-group">
                <div class="filter-title">Thương hiệu</div>
                <ul class="filter-list">
                    @if (Model != null && Model.Any())
                    {
                        var brands = Model.Select(p => !string.IsNullOrEmpty(p.Brand) ? p.Brand : "Phong Cách Xanh").Distinct().ToList();
                        foreach (var b in brands)
                        {
                            <li class="filter-item">
                                <label><input type="checkbox" class="brand-filter" value="@b"> @b</label>
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="filter-group">
                <div class="filter-title">Mức giá</div>
                <ul class="filter-list">
                    <li class="filter-item"><label><input type="checkbox" class="price-filter" value="under-1m"> Dưới 1 triệu</label></li>
                    <li class="filter-item"><label><input type="checkbox" class="price-filter" value="1m-5m"> 1 triệu - 5 triệu</label></li>
                    <li class="filter-item"><label><input type="checkbox" class="price-filter" value="over-5m"> Trên 5 triệu</label></li>
                </ul>
            </div>

            <div class="filter-group">
                <button type="button" id="resetFilter" class="reset-filter-btn">Xóa bộ lọc</button>
            </div>
        </aside>

        <!-- DANH SÁCH -->
        <section class="shop-content">
            <div class="product-top-bar">
                <span class="product-count" id="productCount">Hiển thị sản phẩm</span>
                <select id="sortSelect" class="sort-select">
                    <option value="default">Mặc định</option>
                    <option value="price-asc">Giá: Thấp đến cao</option>
                    <option value="price-desc">Giá: Cao đến thấp</option>
                </select>
            </div>

            <div class="product-grid" id="productGrid">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        // Lấy giá trị để sắp xếp JS (ưu tiên dùng SalePrice nếu có sale, ngược lại dùng Price)
                        decimal effectivePrice = (item.SalePrice != null && item.SalePrice > 0 && item.SalePrice < item.Price) ? item.SalePrice.Value : item.Price;

                        <article class="product-card" data-name="@item.Title" data-brand="@(item.Brand ?? "Phong Cách Xanh")" data-price="@effectivePrice">
                            <a href="@Url.Action("ProductDetail", "Home2", new { id = item.ProductID })">
                                <div class="sale-tag">Hot</div>
                                <div class="product-photo">
                                    <img src="@Url.Content(!string.IsNullOrEmpty(item.ProductImage) ? item.ProductImage : "~/Content/image2/thumb.jpg")" alt="@item.Title">
                                </div>
                                <div class="product-info">
                                    <div class="product-brand">@(item.Brand ?? "Phong Cách Xanh")</div>
                                    <h3 class="product-name">@item.Title</h3>
                                    <div class="product-price-row">
                                        @if (item.SalePrice != null && item.SalePrice > 0 && item.SalePrice < item.Price)
                                        {
                                            <div class="price-box">
                                                <strong class="product-price text-danger">@string.Format("{0:N0} ₫", item.SalePrice)</strong>
                                                <span class="original-price">@string.Format("{0:N0} ₫", item.Price)</span>
                                            </div>
                                            <div class="sale-badge-label">Sale</div>
                                        }
                                        else
                                        {
                                            <strong class="product-price">@string.Format("{0:N0} ₫", item.Price)</strong>
                                        }
                                        <span class="product-rating">★ 5.0</span>
                                    </div>
                                </div>
                            </a>
                        </article>
                    }
                }
                else
                {
                    <div class="no-result">Không có sản phẩm nào trong hệ thống.</div>
                }
            </div>
        </section>
    </div>
</div>

<style>
    .category-wrap {
        width: min(1180px, 92%);
        margin: 0 auto;
        padding: 40px 0 60px;
    }

    .page-header {
        margin-bottom: 30px;
    }

        .page-header h1 {
            font-size: clamp(28px, 3vw, 36px);
            margin-bottom: 8px;
        }

        .page-header p {
            color: #717680;
            font-size: 14px;
        }

    .shop-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 24px;
        align-items: start;
    }

    .filter-sidebar {
        background: #fff;
        border: 1px solid #e7e8eb;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 5px 18px rgba(25, 26, 29, .04);
    }

    .filter-group {
        margin-bottom: 24px;
    }

        .filter-group:last-child {
            margin-bottom: 0;
        }

    .filter-title {
        font-size: 15px;
        font-weight: 750;
        margin-bottom: 12px;
    }

    .filter-search-input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #e7e8eb;
        border-radius: 10px;
        outline: none;
        font-size: 14px;
    }

    .filter-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .filter-item label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        color: #333;
        cursor: pointer;
    }

    .filter-item input[type="checkbox"] {
        accent-color: #3b4d9b;
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .reset-filter-btn {
        width: 100%;
        padding: 10px;
        border: 1px solid #e7e8eb;
        border-radius: 10px;
        background: #f7f7f8;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
    }

        .reset-filter-btn:hover {
            background: #ececee;
        }

    .product-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        background: #fff;
        padding: 14px 20px;
        border: 1px solid #e7e8eb;
        border-radius: 14px;
    }

    .product-count {
        font-size: 14px;
        color: #717680;
    }

    .sort-select {
        padding: 8px 12px;
        border: 1px solid #e7e8eb;
        border-radius: 8px;
        outline: none;
        font-size: 14px;
        background: #fff;
        cursor: pointer;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .product-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e7e8eb;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 6px 22px rgba(25, 26, 29, .045);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 35px rgba(25, 26, 29, .1);
        }

        .product-card a {
            text-decoration: none;
            color: inherit;
            display: block;
        }

    .sale-tag {
        position: absolute;
        z-index: 2;
        top: 12px;
        left: 12px;
        padding: 6px 9px;
        border-radius: 8px;
        background: #ef4444;
        color: #fff;
        font-size: 12px;
        font-weight: 800;
    }

    .product-photo {
        height: 220px;
        padding: 18px;
        background: #f7f7f8;
    }

        .product-photo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 12px;
            display: block;
            background: #fff;
        }

    .product-info {
        padding: 16px 16px 18px;
    }

    .product-brand {
        color: #858a94;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 7px;
    }

    .product-name {
        min-height: 44px;
        font-size: 15px;
        line-height: 1.4;
        margin-bottom: 10px;
        color: #111;
    }

    .product-price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .product-price {
        font-size: 17px;
        font-weight: 850;
    }

    /* CSS HIỂN THỊ GIÁ SALE */
    .price-box {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .product-price.text-danger {
        color: #dc2626;
        font-size: 16px;
        font-weight: 850;
    }

    .original-price {
        font-size: 12px;
        color: #94a3b8;
        text-decoration: line-through;
        font-weight: 600;
    }

    .sale-badge-label {
        background: #fee2e2;
        color: #dc2626;
        font-size: 10px;
        font-weight: 800;
        padding: 2px 5px;
        border-radius: 4px;
        text-transform: uppercase;
    }

    .product-rating {
        color: #f4a300;
        font-size: 13px;
        white-space: nowrap;
    }

    .no-result {
        grid-column: 1 / -1;
        text-align: center;
        padding: 40px;
        color: #717680;
        font-size: 15px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e7e8eb;
    }
</style>

@section Scripts {
    <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const searchInput = document.getElementById("filterSearch");
                    const brandCheckboxes = document.querySelectorAll(".brand-filter");
                    const priceCheckboxes = document.querySelectorAll(".price-filter");
                    const sortSelect = document.getElementById("sortSelect");
                    const resetButton = document.getElementById("resetFilter");
                    const productGrid = document.getElementById("productGrid");
                    const productCount = document.getElementById("productCount");

                    let cards = Array.from(productGrid.querySelectorAll(".product-card"));

                    function filterAndSortProducts() {
                        const keyword = searchInput.value.trim().toLowerCase();
                        const selectedBrands = Array.from(brandCheckboxes).filter(chk => chk.checked).map(chk => chk.value.toLowerCase());
                        const selectedPrices = Array.from(priceCheckboxes).filter(chk => chk.checked).map(chk => chk.value);

                        let visibleCards = cards.filter(card => {
                            const name = (card.dataset.name || "").toLowerCase();
                            const brand = (card.dataset.brand || "").toLowerCase();
                            const price = Number(card.dataset.price || 0);

                            const matchSearch = !keyword || name.includes(keyword);
                            const matchBrand = selectedBrands.length === 0 || selectedBrands.includes(brand);

                            let matchPrice = true;
                            if (selectedPrices.length > 0) {
                                matchPrice = selectedPrices.some(range => {
                                    if (range === 'under-1m') return price < 1000000;
                                    if (range === '1m-5m') return price >= 1000000 && price <= 5000000;
                                    if (range === 'over-5m') return price > 5000000;
                                    return false;
                                });
                            }

                            return matchSearch && matchBrand && matchPrice;
                        });

                        const sortValue = sortSelect.value;
                        if (sortValue === 'price-asc') {
                            visibleCards.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
                        } else if (sortValue === 'price-desc') {
                            visibleCards.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
                        }

                        productGrid.innerHTML = "";
                        if (visibleCards.length > 0) {
                            visibleCards.forEach(card => productGrid.appendChild(card));
                            productCount.textContent = `Hiển thị ${visibleCards.length} sản phẩm`;
                        } else {
                            productGrid.innerHTML = `<div class="no-result">Không tìm thấy sản phẩm phù hợp với bộ lọc của bạn.</div>`;
                            productCount.textContent = `Hiển thị 0 sản phẩm`;
                        }
                    }

                    searchInput.addEventListener("input", filterAndSortProducts);
                    brandCheckboxes.forEach(chk => chk.addEventListener("change", filterAndSortProducts));
                    priceCheckboxes.forEach(chk => chk.addEventListener("change", filterAndSortProducts));
                    sortSelect.addEventListener("change", filterAndSortProducts);

                    resetButton.addEventListener("click", function () {
                        searchInput.value = "";
                        brandCheckboxes.forEach(chk => chk.checked = false);
                        priceCheckboxes.forEach(chk => chk.checked = false);
                        sortSelect.value = "default";
                        filterAndSortProducts();
                    });

                    filterAndSortProducts();
                });
    </script>
}