@model IEnumerable<template.Models.Product>
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    /* --- CSS RIÊNG CHO TRANG CHỦ --- */
    .home-wrap {
        width: 100%;
        overflow: hidden;
        flex: 1;
    }

    /* HERO SLIDER */
    .hero {
        position: relative;
        min-height: 520px;
        background: #0b0b11;
        overflow: hidden;
    }

    .hero-slide {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity .45s ease, visibility .45s ease;
        background-size: cover;
        background-position: center;
    }

        .hero-slide.active {
            opacity: 1;
            visibility: visible;
        }

        .hero-slide::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(7, 7, 15, .92) 0%, rgba(8, 8, 18, .72) 40%, rgba(8, 8, 18, .08) 100%);
        }

    .hero-1 {
        background-image: url('https://images.unsplash.com/photo-1593305841991-05c297ba4575?auto=format&fit=crop&w=1800&q=85');
    }

    .hero-2 {
        background-image: url('https://images.unsplash.com/photo-1547394765-185e1e68f34e?auto=format&fit=crop&w=1800&q=85');
    }

    .hero-3 {
        background-image: url('https://images.unsplash.com/photo-1616588589676-62b3bd4ff6d2?auto=format&fit=crop&w=1800&q=85');
    }

    .hero-content {
        position: relative;
        z-index: 2;
        width: min(1180px, 92%);
        margin: 0 auto;
        color: #fff;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .1);
        border: 1px solid rgba(255, 255, 255, .18);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .hero-title {
        max-width: 610px;
        font-size: clamp(42px, 5vw, 72px);
        line-height: .98;
        letter-spacing: -2px;
        margin-bottom: 20px;
    }

    .hero-desc {
        max-width: 530px;
        color: #d7d7df;
        line-height: 1.7;
        font-size: 16px;
        margin-bottom: 28px;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 22px;
        border: none;
        border-radius: 10px;
        background: #fff;
        color: #111;
        text-decoration: none;
        font-weight: 800;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .hero-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,.22);
        }

    .hero-controls {
        position: absolute;
        z-index: 5;
        left: 50%;
        bottom: 26px;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .hero-dot {
        width: 10px;
        height: 10px;
        border: 0;
        border-radius: 50%;
        background: rgba(255,255,255,.46);
        cursor: pointer;
        transition: all .2s ease;
    }

        .hero-dot.active {
            width: 28px;
            border-radius: 999px;
            background: #fff;
        }

    .hero-pause {
        margin-left: 8px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.35);
        background: rgba(0,0,0,.2);
        color: #fff;
        cursor: pointer;
    }

    /* SECTIONS */
    .section {
        width: min(1180px, 92%);
        margin: 0 auto;
        padding: 58px 0;
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 26px;
    }

        .section-heading h2 {
            font-size: clamp(27px, 3vw, 38px);
            line-height: 1.1;
            margin-bottom: 6px;
        }

        .section-heading p {
            color: #717680;
            font-size: 14px;
        }

    .see-all {
        text-decoration: none;
        color: #111;
        font-weight: 700;
        white-space: nowrap;
    }

    /* CATEGORY GRID */
    .category-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
    }

    .category-card {
        position: relative;
        min-height: 150px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 14px;
        padding: 18px 10px;
        border: 1px solid #e7e8eb;
        border-radius: 16px;
        background: #fff;
        text-decoration: none;
        color: #191a1d;
        box-shadow: 0 5px 18px rgba(25, 26, 29, .04);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .category-card:hover {
            transform: translateY(-5px);
            border-color: #d4d8df;
            box-shadow: 0 14px 28px rgba(25, 26, 29, .09);
        }

    .category-icon {
        width: 56px;
        height: 56px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        background: #f2f4f7;
        font-size: 23px;
    }

    .category-card span {
        text-align: center;
        font-size: 14px;
        font-weight: 750;
    }

    /* PRODUCT GRID */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .product-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e7e8eb;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 6px 22px rgba(25, 26, 29, .045);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 35px rgba(25, 26, 29, .1);
        }

        .product-card a {
            text-decoration: none;
            color: inherit;
            display: block;
        }

    .sale-tag {
        position: absolute;
        z-index: 2;
        top: 12px;
        left: 12px;
        padding: 6px 9px;
        border-radius: 8px;
        background: #ef4444;
        color: #fff;
        font-size: 12px;
        font-weight: 800;
    }

    .product-photo {
        height: 245px;
        padding: 18px;
        background: #f7f7f8;
    }

        .product-photo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 12px;
            display: block;
            background: #fff;
        }

    .product-info {
        padding: 16px 16px 18px;
    }

    .product-brand {
        color: #858a94;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 7px;
    }

    .product-name {
        min-height: 44px;
        font-size: 16px;
        line-height: 1.4;
        margin-bottom: 10px;
    }

    .product-price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .product-price {
        font-size: 18px;
        font-weight: 850;
    }

    .price-box {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .product-price.text-danger {
        color: #dc2626;
        font-size: 17px;
        font-weight: 850;
    }

    .original-price {
        font-size: 13px;
        color: #94a3b8;
        text-decoration: line-through;
        font-weight: 600;
    }

    .sale-badge-label {
        background: #fee2e2;
        color: #dc2626;
        font-size: 11px;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 4px;
        text-transform: uppercase;
    }

    .product-rating {
        color: #f4a300;
        font-size: 13px;
        white-space: nowrap;
    }

    /* BENEFITS */
    .benefit-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .benefit-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border-radius: 16px;
        background: #fff;
        border: 1px solid #e7e8eb;
    }

    .benefit-icon {
        flex: 0 0 46px;
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        background: #f2f4f7;
        font-size: 18px;
    }

    .benefit-card h3 {
        font-size: 15px;
        margin-bottom: 4px;
    }

    .benefit-card p {
        color: #737780;
        font-size: 13px;
        line-height: 1.5;
    }

    .chat-btn {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 20;
        width: 58px;
        height: 58px;
        border: 0;
        border-radius: 50%;
        background: #2196f3;
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 23px;
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(33, 150, 243, .33);
        transition: transform .2s ease;
    }

        .chat-btn:hover {
            transform: scale(1.06);
        }
</style>

<div class="home-wrap">
    <!-- BANNER -->
    <section class="hero" aria-label="Banner quảng cáo">
        <article class="hero-slide hero-1 active">
            <div class="hero-content">
                <div class="hero-eyebrow">
                    <i class="fa-solid fa-bolt"></i> Gaming gear mới
                </div>
                <h1 class="hero-title">Pulsar PRO<br />Susanto-X 2.0</h1>
                <p class="hero-desc">
                    Chuột gaming không dây siêu nhẹ, thiết kế dành cho game thủ cần tốc độ,
                    độ chính xác và cảm giác cầm nắm thoải mái.
                </p>
                <a href="#best-seller" class="hero-btn">
                    Xem thêm <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </article>

        <article class="hero-slide hero-2">
            <div class="hero-content">
                <div class="hero-eyebrow">
                    <i class="fa-solid fa-gamepad"></i> Gaming setup
                </div>
                <h2 class="hero-title">Nâng cấp<br />góc game của bạn</h2>
                <p class="hero-desc">
                    Từ chuột, bàn phím đến tai nghe và mousepad — chọn đúng gear để setup
                    vừa đẹp vừa chiến.
                </p>
                <a href="#categories" class="hero-btn">
                    Khám phá ngay <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </article>

        <article class="hero-slide hero-3">
            <div class="hero-content">
                <div class="hero-eyebrow">
                    <i class="fa-solid fa-star"></i> Best seller
                </div>
                <h2 class="hero-title">Gear xịn<br />chơi game đã</h2>
                <p class="hero-desc">
                    Những sản phẩm được nhiều game thủ lựa chọn, nổi bật về hiệu năng và thiết kế.
                </p>
                <a href="#best-seller" class="hero-btn">
                    Xem sản phẩm <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </article>

        <div class="hero-controls">
            <button class="hero-dot active" data-slide="0" aria-label="Banner 1"></button>
            <button class="hero-dot" data-slide="1" aria-label="Banner 2"></button>
            <button class="hero-dot" data-slide="2" aria-label="Banner 3"></button>
            <button class="hero-pause" id="heroPause" aria-label="Tạm dừng banner">
                <i class="fa-solid fa-pause"></i>
            </button>
        </div>
    </section>

    <!-- DANH MỤC -->
    <section class="section" id="categories">
        <div class="section-heading">
            <div>
                <h2>Danh mục chính</h2>
                <p>Chọn nhanh nhóm sản phẩm bạn đang tìm kiếm</p>
            </div>
            <a class="see-all" href="@Url.Action("ProductList", "Home2")">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="category-grid">
            <a href="@Url.Action("ProductList", "Home2", new { categoryId = 1 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-computer-mouse"></i></div>
                <span>Chuột Gaming</span>
            </a>
            <a href="@Url.Action("ProductList", "Home2", new { categoryId = 2 })" class="category-card">
                <div class="category-icon"><i class="fa-regular fa-keyboard"></i></div>
                <span>Bàn phím</span>
            </a>
            <a href="@Url.Action("ProductList", "Home2", new { categoryId = 3 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-headphones"></i></div>
                <span>Tai nghe</span>
            </a>
            <a href="@Url.Action("ProductList", "Home2", new { categoryId = 4 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-mouse"></i></div>
                <span>Mousepad</span>
            </a>
            <a href="@Url.Action("ProductList", "Home2", new { categoryId = 5 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-desktop"></i></div>
                <span>Màn hình</span>
            </a>
            <a href="@Url.Action("ProductList", "Home2", new { categoryId = 6 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-keyboard"></i></div>
                <span>Phụ kiện</span>
            </a>
        </div>
    </section>

    <!-- 1. GỌI PARTIAL VIEW SẢN PHẨM NỔI BẬT -->
    @Html.Partial("_PVFeatureProduct", Model)

    <!-- 2. GỌI PARTIAL VIEW SẢN PHẨM MỚI -->
    @Html.Partial("_PVNewProduct", Model)

    <!-- DỊCH VỤ -->
    <section class="section">
        <div class="benefit-grid">
            <article class="benefit-card">
                <div class="benefit-icon"><i class="fa-solid fa-truck-fast"></i></div>
                <div>
                    <h3>Giao hàng nhanh</h3>
                    <p>Đóng gói kỹ và hỗ trợ giao hàng toàn quốc.</p>
                </div>
            </article>
            <article class="benefit-card">
                <div class="benefit-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <div>
                    <h3>Chính hãng & bảo hành</h3>
                    <p>Thông tin sản phẩm rõ ràng, hỗ trợ sau mua.</p>
                </div>
            </article>
            <article class="benefit-card">
                <div class="benefit-icon"><i class="fa-solid fa-headset"></i></div>
                <div>
                    <h3>Hỗ trợ game thủ</h3>
                    <p>Tư vấn gear phù hợp theo nhu cầu và ngân sách.</p>
                </div>
            </article>
        </div>
    </section>
</div>

<!-- NÚT CHAT -->
<button class="chat-btn" type="button" aria-label="Mở hỗ trợ chat">
    <i class="fa-solid fa-message"></i>
</button>

<script>
        (function () {
            const slides = Array.from(document.querySelectorAll('.hero-slide'));
            const dots = Array.from(document.querySelectorAll('.hero-dot'));
            const pauseButton = document.getElementById('heroPause');
            if (!slides.length) return;

            let current = 0;
            let paused = false;
            let timer;

            function showSlide(index) {
                current = (index + slides.length) % slides.length;
                slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
                dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
            }

            function startTimer() {
                clearInterval(timer);
                if (!paused) {
                    timer = setInterval(() => showSlide(current + 1), 5000);
                }
            }

            dots.forEach(dot => {
                dot.addEventListener('click', () => {
                    showSlide(Number(dot.dataset.slide));
                    startTimer();
                });
            });

            pauseButton?.addEventListener('click', () => {
                paused = !paused;
                pauseButton.innerHTML = paused
                    ? '<i class="fa-solid fa-play"></i>'
                    : '<i class="fa-solid fa-pause"></i>';
                startTimer();
            });

            showSlide(0);
            startTimer();
        })();
</script>