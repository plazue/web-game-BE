@model template.Models.Product

<style>
    /* --- CSS CHO PARTIAL VIEW CHI TIẾT SẢN PHẨM --- */
    .product-detail-wrapper {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        padding: 30px;
        margin-bottom: 30px;
    }

    .product-page {
        display: flex;
        gap: 25px;
        max-width: 1200px;
        margin: 0 auto;
        color: #111;
        align-items: flex-start;
        background: #fff;
        padding: 10px 0;
    }

    .thumb {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 75px;
        flex-shrink: 0;
        max-height: 350px;
        overflow-y: auto;
    }

    .box {
        width: 75px;
        height: 75px;
        border: 1px solid #ddd;
        border-radius: 6px;
        overflow: hidden;
        cursor: pointer;
        opacity: 0.7;
        transition: all 0.2s;
        background: #f8fafc;
        flex-shrink: 0;
    }

        .box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .box:hover, .box.active {
            border-color: #2563eb;
            opacity: 1;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
        }

    .product-showcase {
        flex: 1.2;
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 30px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fff;
    }

    .showcase-wrapper {
        position: relative;
        width: 100%;
        max-width: 380px;
    }

    .main-image {
        width: 100%;
        height: 320px;
        object-fit: contain;
        display: block;
        border-radius: 6px;
    }

    .product-details {
        flex: 1.3;
        padding-top: 5px;
    }

    .product-brand {
        font-size: 13px;
        color: #666;
        margin-bottom: 6px;
        display: block;
        text-transform: uppercase;
        font-weight: 600;
    }

    .product-title {
        font-size: 22px;
        font-weight: 700;
        margin: 0 0 12px 0;
        line-height: 1.35;
        color: #1e293b;
    }

    .product-rating {
        font-size: 14px;
        margin-bottom: 15px;
        color: #64748b;
    }

    .product-price-box {
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .current-price {
        font-size: 24px;
        font-weight: 700;
        color: #dc2626;
        margin-bottom: 0;
    }

    .old-price {
        text-decoration: line-through;
        color: #94a3b8;
        font-size: 16px;
        font-weight: 600;
    }

    .product-stock {
        font-size: 14px;
        color: #0369a1;
        background-color: #e0f2fe;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-block;
        font-weight: 600;
    }

    .option-label {
        border: 1px solid #cbd5e1;
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        background: #f8fafc;
        font-weight: 600;
        color: #1e293b;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

        .option-label:hover {
            border-color: #2563eb;
            background: #eff6ff;
        }

    .divider {
        border: none;
        border-top: 1px solid #eee;
        margin: 20px 0;
    }

    .thongtin {
        font-size: 15px;
        color: #475569;
        line-height: 1.6;
        margin-top: 10px;
        padding: 15px;
        background-color: #f8fafc;
        border-radius: 8px;
        border-left: 4px solid #2563eb;
    }

    .product-specs-container {
        max-width: 100%;
        margin: 30px 0 0 0;
        background: #fff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .spec-row {
        display: flex;
        padding: 15px 0;
        border-bottom: 1px solid #eee;
        align-items: flex-start;
    }

    .spec-label {
        width: 220px;
        font-weight: 600;
        color: #111;
        font-size: 15px;
    }

    .spec-value {
        flex: 1;
        color: #333;
        font-size: 15px;
        line-height: 1.6;
        white-space: pre-line;
    }

    /* CSS cho bộ chọn số lượng & nút Thêm giỏ hàng */
    .quantity-container {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 15px;
    }

    .quantity-input-group {
        display: flex;
        align-items: center;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
        background: #f8fafc;
    }

    .qty-btn {
        background: #f1f5f9;
        border: none;
        padding: 10px 14px;
        cursor: pointer;
        font-weight: bold;
        color: #334151;
        transition: background 0.2s;
    }

        .qty-btn:hover {
            background: #e2e8f0;
        }

    .quantity-input {
        width: 50px;
        text-align: center;
        border: none;
        background: transparent;
        font-size: 15px;
        font-weight: 600;
        outline: none;
    }

    .btn-add-to-cart {
        background-color: #2563eb;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.2s;
        text-decoration: none;
    }

        .btn-add-to-cart:hover {
            background-color: #1d4ed8;
        }
</style>

<div class="product-detail-wrapper">
    <div class="product-page">
        <!-- Thumbnail Gallery -->
        <div class="thumb">
            @if (!string.IsNullOrEmpty(Model.ProductImage))
            {
                <div class="box active" onclick="changeMainImage(this, '@Url.Content(Model.ProductImage)')">
                    <img src="@Url.Content(Model.ProductImage)" alt="Main Thumb">
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ProductImages1))
            {
                var subImages = Model.ProductImages1.Split(new char[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
                foreach (var img in subImages)
                {
                    var trimmedImg = img.Trim();
                    <div class="box" onclick="changeMainImage(this, '@Url.Content(trimmedImg)')">
                        <img src="@Url.Content(trimmedImg)" alt="Sub Thumb">
                    </div>
                }
            }
        </div>

        <!-- Main Showcase Image -->
        <div class="product-showcase">
            <div class="showcase-wrapper">
                <img id="mainProductImage" src="@(!string.IsNullOrEmpty(Model.ProductImage) ? Url.Content(Model.ProductImage) : Url.Content("~/Content/image2/5.jpg"))" alt="Main Image" class="main-image">
            </div>
        </div>

        <!-- Product Info Details -->
        <div class="product-details">
            <span class="product-brand">@(string.IsNullOrEmpty(Model.Brand) ? (Model.Category != null ? Model.Category.CategoryName : "") : Model.Brand)</span>
            <h1 class="product-title">@Model.Title</h1>

            <div class="product-rating">
                <span class="stars">⭐ 5.0</span>
                <span class="reviews">(Chủng loại: @(Model.Category != null ? Model.Category.CategoryName : "N/A"))</span>
            </div>

            <!-- Giá tiền -->
            <div class="product-price-box">
                @if (Model.SalePrice.HasValue && Model.SalePrice.Value > 0)
                {
                    <span class="current-price">@string.Format("{0:N0} ₫", Model.SalePrice.Value)</span>
                    <span class="old-price">@string.Format("{0:N0} ₫", Model.Price)</span>
                }
                else
                {
                    <span class="current-price" style="color: #2563eb;">@string.Format("{0:N0} ₫", Model.Price)</span>
                }
            </div>

            <!-- Tồn kho -->
            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 15px;">
                <span class="product-stock">Tồn kho: @(Model.StockQuantity ?? 0) sản phẩm</span>
            </div>

            <!-- CÁC TÙY CHỌN (Phân loại & Màu sắc) -->
            <div style="display: flex; flex-direction: column; gap: 16px; margin-top: 15px;">
                @if (!string.IsNullOrEmpty(Model.ProductType))
                {
                    <div>
                        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; color: #334151;">Phân loại / Kích thước:</label>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                            @{
                                var typeList = Model.ProductType.Split(new char[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
                                bool isFirstType = true;
                                foreach (var t in typeList)
                                {
                                    var trimmedType = t.Trim();
                                    <label class="option-label">
                                        <input type="radio" name="selectedProductType" value="@trimmedType" @(isFirstType ? "checked" : "") style="margin-right: 4px;" />
                                        @trimmedType
                                    </label>
                                    isFirstType = false;
                                }
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Color))
                {
                    <div>
                        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; color: #334151;">Chọn màu sắc:</label>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                            @{
                                var colorList = Model.Color.Split(new char[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
                                bool isFirstColor = true;
                                foreach (var col in colorList)
                                {
                                    var trimmedColor = col.Trim();
                                    <label class="option-label">
                                        <input type="radio" name="selectedColor" value="@trimmedColor" @(isFirstColor ? "checked" : "") style="margin-right: 4px;" />
                                        @trimmedColor
                                    </label>
                                    isFirstColor = false;
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- FORM THÊM VÀO GIỎ HÀNG (Giới hạn max = StockQuantity) -->
            @using (Html.BeginForm("AddToCart", "Cart", new { area = "Customer" }, FormMethod.Post))
            {
                @Html.Hidden("productId", Model.ProductID)
                <div class="quantity-container">
                    <div class="quantity-input-group">
                        <button type="button" class="qty-btn" onclick="decreaseQty()">-</button>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" max="@(Model.StockQuantity ?? 1)" class="quantity-input" />
                        <button type="button" class="qty-btn" onclick="increaseQty(@(Model.StockQuantity ?? 1))">+</button>
                    </div>

                    @if (Model.StockQuantity != null && Model.StockQuantity > 0)
                    {
                        <button type="submit" class="btn-add-to-cart">
                            <i class="fa-solid fa-cart-shopping"></i> Thêm vào giỏ hàng
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn-add-to-cart" style="background-color: #94a3b8; cursor: not-allowed;" disabled>
                            Hết hàng
                        </button>
                    }
                </div>
            }

            <hr class="divider">

            <div class="thongtin">
                @(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả chi tiết cho sản phẩm này." : Model.Description)
            </div>
        </div>
    </div>

    <!-- Bảng thông số kỹ thuật -->
    <div class="product-specs-container">
        <div class="spec-row">
            <div class="spec-label">Mã sản phẩm</div>
            <div class="spec-value">#@Model.ProductID</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Thương hiệu</div>
            <div class="spec-value">@(string.IsNullOrEmpty(Model.Brand) ? "N/A" : Model.Brand)</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Phân loại / Kích thước</div>
            <div class="spec-value">@(string.IsNullOrEmpty(Model.ProductType) ? "N/A" : Model.ProductType)</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Màu sắc hỗ trợ</div>
            <div class="spec-value">@(string.IsNullOrEmpty(Model.Color) ? "N/A" : Model.Color)</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Chủng loại</div>
            <div class="spec-value">@(Model.Category != null ? Model.Category.CategoryName : "N/A")</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Số lượng tồn kho</div>
            <div class="spec-value">@(Model.StockQuantity ?? 0)</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Mô tả chi tiết</div>
            <div class="spec-value">@(string.IsNullOrEmpty(Model.Description) ? "Không có thông tin mô tả." : Model.Description)</div>
        </div>
    </div>
</div>

<script>
        function changeMainImage(element, imgUrl) {
            document.getElementById('mainProductImage').src = imgUrl;
            var boxes = document.querySelectorAll('.thumb .box');
            boxes.forEach(function(box) {
                box.classList.remove('active');
            });
            element.classList.add('active');
        }

        function decreaseQty() {
            var input = document.getElementById('quantity');
            var val = parseInt(input.value) || 1;
            if (val > 1) {
                input.value = val - 1;
            }
        }

        function increaseQty(maxStock) {
            var input = document.getElementById('quantity');
            var val = parseInt(input.value) || 1;
            if (val < maxStock) {
                input.value = val + 1;
            }
        }
</script>