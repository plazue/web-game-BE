<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Phong Cách Xanh</title>
    <script src="https://kit.fontawesome.com/2ba83b9efc.js" crossorigin="anonymous"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f8fafc;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 40px;
            background-color: #ffffff;
            border-bottom: 1px solid #e5e5e5;
            width: 100%;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }

        .logo-text {
            font-size: 22px;
            font-weight: 300;
            color: #222;
            letter-spacing: -0.5px;
        }

        .nav-links ul {
            display: flex;
            list-style: none;
            gap: 24px;
        }

        .nav-item {
            text-decoration: none;
            color: #111827;
            font-weight: 600;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: color 0.2s ease;
            white-space: nowrap;
        }

            .nav-item:hover {
                color: #0056b3;
            }

        .right-section {
            display: flex;
            align-items: center;
            gap: 20px;
            white-space: nowrap;
        }

        .search-box {
            display: flex;
            align-items: center;
            background-color: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 8px 14px;
            width: 260px;
        }

        .search-icon {
            color: #6b7280;
            font-size: 14px;
            margin-right: 8px;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            width: 100%;
            font-size: 14px;
            color: #374151;
        }

        .user-icons {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .icon-btn {
            color: #111827;
            font-size: 18px;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .icon-btn:hover {
                color: #0056b3;
            }

        .main-content {
            flex: 1;
        }

        .site-footer {
            background-color: #0b132b;
            color: #ffffff;
            padding: 50px 60px 30px 60px;
            margin-top: 50px;
        }

        .footer-top {
            max-width: 600px;
            margin-bottom: 40px;
        }

            .footer-top h3 {
                font-size: 24px;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .footer-top p {
                font-size: 14px;
                color: #b0b3c6;
                margin-bottom: 20px;
            }

        .newsletter-form {
            display: flex;
            align-items: center;
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            padding: 6px 6px 6px 16px;
            max-width: 500px;
        }

            .newsletter-form input {
                flex: 1;
                background: transparent;
                border: none;
                outline: none;
                color: #fff;
                font-size: 14px;
            }

                .newsletter-form input::placeholder {
                    color: #8c90a2;
                }

        .newsletter-btn {
            background-color: #2563eb;
            color: white;
            border: none;
            width: 38px;
            height: 38px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }

            .newsletter-btn:hover {
                background-color: #1d4ed8;
            }

        .footer-accordion {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .accordion-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            color: #f1f5f9;
        }

            .accordion-item i {
                font-size: 12px;
                color: #b0b3c6;
            }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 40px;
        }

        .social-icons {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

            .social-icons a {
                color: #fff;
                font-size: 20px;
                text-decoration: none;
                transition: color 0.2s;
            }

                .social-icons a:hover {
                    color: #2563eb;
                }

        .copyright {
            font-size: 13px;
            color: #94a3b8;
        }

        .gov-badge img {
            height: 45px;
        }

        /* --- CSS SUBMENU GIỎ HÀNG --- */
        .cart-dropdown-wrapper {
            position: relative;
            display: inline-block;
        }

        .cart-icon-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background-color: #dc2626;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            padding: 1px 5px;
            border-radius: 10px;
            line-height: 14px;
            min-width: 18px;
            text-align: center;
        }

        .cart-submenu {
            position: absolute;
            right: 0;
            top: 100%;
            width: 320px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            padding: 16px;
            display: none;
            z-index: 1000;
            margin-top: 10px;
        }

        .cart-dropdown-wrapper:hover .cart-submenu {
            display: block;
        }

        .submenu-header {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 12px;
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 8px;
        }

        .submenu-items-list {
            max-height: 220px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 12px;
        }

        .submenu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
        }

            .submenu-item img {
                width: 40px;
                height: 40px;
                object-fit: contain;
                border-radius: 6px;
                border: 1px solid #f1f5f9;
                background: #f8fafc;
                padding: 2px;
            }

        .submenu-item-info {
            flex: 1;
        }

        .submenu-item-name {
            font-weight: 600;
            color: #334155;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .submenu-item-price {
            color: #64748b;
            font-size: 12px;
        }

        .submenu-footer {
            border-top: 1px solid #f1f5f9;
            padding-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .submenu-total {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
        }

        .btn-view-cart {
            display: block;
            text-align: center;
            background: #2563eb;
            color: #fff;
            padding: 8px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 13px;
            transition: background 0.2s;
        }

            .btn-view-cart:hover {
                background: #1d4ed8;
                color: #fff;
            }

        .submenu-empty {
            text-align: center;
            color: #64748b;
            font-size: 13px;
            padding: 15px 0;
        }

        /* Nút chuyển trang Admin */
        .btn-admin-link {
            background: #0f172a;
            color: #fff;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: background 0.2s;
        }

            .btn-admin-link:hover {
                background: #1e293b;
                color: #fff;
            }
    </style>
</head>
<body>

    <!-- THANH ĐIỀU HƯỚNG KHÁCH HÀNG -->
    <div class="navbar">
        <div class="logo" onclick="location.href='@Url.Action("Index", "Home2")'">
            <svg class="logo-icon" viewBox="0 0 100 100" width="35" height="35">
                <circle cx="50" cy="50" r="45" fill="none" stroke="#111" stroke-width="4" />
                <path d="M 30,50 Q 50,20 70,50 T 30,50" fill="none" stroke="#111" stroke-width="4" />
            </svg>
            <span class="logo-text">Phong Cách Xanh</span>
        </div>

        <nav class="nav-links">
            <ul>
                <li><a href="@Url.Action("Index", "Home2")" class="nav-item">Trang chính</a></li>
                <li><a href="@Url.Action("ProductList", "Home2")" class="nav-item">Sản phẩm</a></li>
                <li><a href="@Url.Action("OrderHistory", "Order")" class="nav-item">Lịch sử đơn hàng</a></li>
                <li><a href="@Url.Action("Edit", "Account")" class="nav-item">Thông tin tài khoản</a></li>
            </ul>
        </nav>

        <div class="right-section">
            <!-- THANH TÌM KIẾM -->
            <form action="@Url.Action("ProductList", "Home2", new { area = "Customer" })" method="get" class="search-box">
                <button type="submit" style="background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center;">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                </button>
                <input type="text" name="searchKeyword" placeholder="Tìm chuột, bàn phím..." value="@Request.QueryString["searchKeyword"]" />
            </form>

            <div class="user-icons" style="display: flex; align-items: center; gap: 14px;">
                @if (Session["UserID"] != null)
                {
                    <!-- HIỂN THỊ NÚT ADMIN KHI TÀI KHOẢN LÀ ADMIN -->
                    if ((Session["Role"] != null && Session["Role"].ToString() == "Admin") || (Session["IsAdmin"] != null && (bool)Session["IsAdmin"] == true))
                    {
                        <a href="@Url.Action("Index", "Products", new { area = "Admin" })" class="btn-admin-link" title="Chuyển đến trang Quản trị">
                            <i class="fa-solid fa-user-shield"></i> Trang Admin
                        </a>
                    }

                    <!-- ĐÃ ĐĂNG NHẬP: Hiển thị tên và nút thoát -->
                    <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: #111827;">
                        <i class="fa-regular fa-circle-user" style="font-size: 18px; color: #2563eb;"></i>
                        <span>Chào, @(Session["FullName"] ?? Session["Username"] ?? "Thành viên")</span>
                        <a href="@Url.Action("Logout", "Account")" title="Đăng xuất" style="color: #dc2626; font-size: 13px; text-decoration: none; margin-left: 6px; padding: 4px 8px; background: #fee2e2; border-radius: 4px;">Thoát</a>
                    </div>
                }
                else
                {
                    <!-- CHƯA ĐĂNG NHẬP: Hiển thị nút dẫn tới trang Login -->
                    <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập / Tài khoản" style="font-size: 18px;"><i class="fa-regular fa-circle-user"></i></a>
                }

                <!-- KHU VỰC GIỎ HÀNG CÓ SUBMENU -->
                <div class="cart-dropdown-wrapper">
                    @{
                        var sessionCart = Session["Cart"] as List<template.Models.ViewModels.CartItemViewModel>;
                        int badgeQty = sessionCart != null ? sessionCart.Sum(x => x.Quantity) : 0;
                        decimal subTotalCart = sessionCart != null ? sessionCart.Sum(x => x.Total) : 0;
                    }

                    <a href="@Url.Action("Index", "Cart", new { area = "Customer" })" class="icon-btn cart-icon-btn" title="Giỏ hàng">
                        <i class="fa-solid fa-basket-shopping"></i>
                        @if (badgeQty > 0)
                        {
                            <span class="cart-badge">@badgeQty</span>
                        }
                    </a>

                    <!-- Submenu danh sách sản phẩm nhanh -->
                    <div class="cart-submenu">
                        <div class="submenu-header">Giỏ hàng của bạn</div>

                        <div class="submenu-items-list">
                            @if (sessionCart != null && sessionCart.Any())
                            {
                                foreach (var item in sessionCart)
                                {
                                    <div class="submenu-item">
                                        <img src="@Url.Content(!string.IsNullOrEmpty(item.Image) ? item.Image : "~/Content/image2/thumb.jpg")" alt="@item.Title" />
                                        <div class="submenu-item-info">
                                            <div class="submenu-item-name">@item.Title</div>
                                            <div class="submenu-item-price">SL: @item.Quantity x @string.Format("{0:N0} ₫", item.Price)</div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="submenu-empty">Giỏ hàng đang trống</div>
                            }
                        </div>

                        <div class="submenu-footer">
                            <div class="submenu-total">
                                <span>Tổng cộng:</span>
                                <span style="color: #dc2626;">@string.Format("{0:N0} ₫", subTotalCart)</span>
                            </div>
                            <a href="@Url.Action("Index", "Cart", new { area = "Customer" })" class="btn-view-cart">Xem chi tiết giỏ hàng</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHUNG HIỂN THỊ NỘI DUNG CÁC TRANG CON -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- PHẦN FOOTER -->
    <footer class="site-footer">
        <div class="footer-top">
            <h3>Nhận tin khuyến mãi</h3>
            <p>Nhận voucher giảm 5% ngay sau khi đăng ký.</p>
            <div class="newsletter-form">
                <input type="email" placeholder="Email">
                <button type="button" class="newsletter-btn">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class="footer-accordion">
            <div class="accordion-item">
                <span>CÔNG TY TNHH PHONG CÁCH XANH</span>
                <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="accordion-item">
                <span>LIÊN HỆ & HỖ TRỢ</span>
                <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="accordion-item">
                <span>CHÍNH SÁCH & HỖ TRỢ</span>
                <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="accordion-item">
                <span>ƯU ĐÃI & CHƯƠNG TRÌNH</span>
                <i class="fa-solid fa-chevron-down"></i>
            </div>
        </div>

        <div class="footer-bottom">
            <div>
                <div class="social-icons">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                </div>
                <div class="copyright">
                    © 2026, Phong Cách Xanh.
                </div>
            </div>
            <div class="gov-badge">
                <img src="https://congthuong.gov.vn/assets/images/logo.png" alt="Đã thông báo Bộ Công Thương" style="opacity: 0.8; height: 40px; background: #fff; padding: 4px; border-radius: 4px;">
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>