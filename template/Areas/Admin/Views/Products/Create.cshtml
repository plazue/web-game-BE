@model template.Models.Product
@{
    ViewBag.Title = "Thêm mới sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<style>
    .admin-form-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        padding: 30px;
        margin-bottom: 30px;
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
    }

    .admin-form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 16px;
        margin-bottom: 24px;
        border-bottom: 2px solid #e2efda;
    }

    .admin-form-title {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        text-transform: uppercase;
        margin: 0;
    }

    .admin-label {
        font-weight: 600;
        color: #334155;
        font-size: 14px;
    }

    .admin-input, .admin-select, .admin-textarea {
        width: 100%;
        padding: 10px 14px;
        font-size: 14px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background-color: #f8fafc;
        color: #1e293b;
        transition: all 0.2s ease;
    }

        .admin-input:focus, .admin-select:focus, .admin-textarea:focus {
            outline: none;
            border-color: #2563eb;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

    .admin-alert-danger {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .btn-admin-submit {
        background-color: #2563eb;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 24px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-admin-submit:hover {
            background-color: #1d4ed8;
        }

    .btn-admin-back {
        background-color: #f1f5f9;
        color: #475569 !important;
        font-weight: 600;
        font-size: 13px;
        padding: 8px 16px;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .image-preview-item {
        width: 70px;
        height: 70px;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        object-fit: cover;
    }
</style>

<div class="admin-form-card">
    <div class="admin-form-header">
        <h3 class="admin-form-title">
            <i class="fa-solid fa-square-plus text-primary me-2"></i> THÊM MỚI SẢN PHẨM
        </h3>
        <a href="@Url.Action("Index")" class="btn-admin-back">
            <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @using (Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <!-- Hiển thị lỗi nếu có để không bị refresh ẩn -->
        @Html.ValidationSummary(false, "", new { @class = "admin-alert-danger" })

        ViewBag.IsEdit = false;
        @Html.Partial("_ProductFormPartial", Model)

        <div class="row mt-4">
            <div class="col-md-9 offset-md-3">
                <button type="submit" class="btn-admin-submit">
                    <i class="fa-solid fa-floppy-disk"></i> Lưu sản phẩm
                </button>
            </div>
        </div>
    }
</div>