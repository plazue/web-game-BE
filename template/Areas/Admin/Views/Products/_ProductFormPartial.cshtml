@model template.Models.Product

@Html.AntiForgeryToken()

<div class="text-danger">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
</div>

<!-- Tên sản phẩm -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Tên sản phẩm <span class="text-danger">*</span></label>
    <div class="col-md-9">
        @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "admin-input", placeholder = "Nhập tên sản phẩm...", required = "required" } })
        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger text-sm" })
    </div>
</div>

<!-- Danh mục -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Danh mục <span class="text-danger">*</span></label>
    <div class="col-md-9">
        @Html.DropDownList("CategoryID", null, "-- Chọn danh mục --", htmlAttributes: new { @class = "admin-select", required = "required" })
        @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger text-sm" })
    </div>
</div>

<!-- Thương hiệu -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Thương hiệu</label>
    <div class="col-md-9">
        @Html.EditorFor(model => model.Brand, new { htmlAttributes = new { @class = "admin-input", placeholder = "Ví dụ: Logitech, Razer..." } })
        @Html.ValidationMessageFor(model => model.Brand, "", new { @class = "text-danger text-sm" })
    </div>
</div>

<!-- Loại sản phẩm / Kích thước -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Loại sản phẩm / Kích thước</label>
    <div class="col-md-9">
        @Html.EditorFor(model => model.ProductType, new { htmlAttributes = new { @class = "admin-input", placeholder = "Ví dụ: 420 x 330 mm, 490 x 420 mm..." } })
        <small class="text-muted">Nhập các kích thước/phân loại ngăn cách bằng dấu phẩy (`,`).</small>
        @Html.ValidationMessageFor(model => model.ProductType, "", new { @class = "text-danger text-sm" })
    </div>
</div>

<!-- Màu sắc -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Màu sắc (Nhiều màu)</label>
    <div class="col-md-9">
        @Html.EditorFor(model => model.Color, new { htmlAttributes = new { @class = "admin-input", placeholder = "Ví dụ: Đen, Trắng, Hồng..." } })
        <small class="text-muted">Nhập các màu ngăn cách nhau bằng dấu phẩy (`,`).</small>
        @Html.ValidationMessageFor(model => model.Color, "", new { @class = "text-danger text-sm" })
    </div>
</div>

<!-- Giá gốc -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Giá gốc (VNĐ) <span class="text-danger">*</span></label>
    <div class="col-md-9">
        @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "admin-input", type = "number", min = "0", placeholder = "Nhập giá gốc...", required = "required" } })
        @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger text-sm" })
    </div>
</div>

<!-- Giá khuyến mãi -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Giá khuyến mãi (VNĐ)</label>
    <div class="col-md-9">
        @Html.EditorFor(model => model.SalePrice, new { htmlAttributes = new { @class = "admin-input", type = "number", min = "0", placeholder = "Nhập giá khuyến mãi..." } })
        @Html.ValidationMessageFor(model => model.SalePrice, "", new { @class = "text-danger text-sm" })
    </div>
</div>

<!-- Số lượng tồn kho -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Số lượng tồn kho</label>
    <div class="col-md-9">
        @Html.EditorFor(model => model.StockQuantity, new { htmlAttributes = new { @class = "admin-input", type = "number", min = "0", placeholder = "Nhập số lượng..." } })
        @Html.ValidationMessageFor(model => model.StockQuantity, "", new { @class = "text-danger text-sm" })
    </div>
</div>

<!-- 🖼️ ẢNH CHÍNH (name="ProductImage") -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Ảnh đại diện chính</label>
    <div class="col-md-9">
        <input type="file" name="ProductImage" class="admin-input" accept="image/*" />
        <small class="text-muted">Chọn 1 ảnh chính (Không bắt buộc).</small>
        @if (!string.IsNullOrEmpty(Model?.ProductImage))
        {
            <div style="margin-top: 8px;">
                <img src="@Url.Content(Model.ProductImage)" alt="Current Image" style="width: 70px; height: 70px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd;" />
                <span class="text-muted d-block" style="font-size: 12px;">Ảnh hiện tại</span>
            </div>
        }
    </div>
</div>

<!-- 🖼️ ẢNH PHỤ (name="ProductImages1" - Không có s) -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Ảnh phụ bổ sung (Nhiều ảnh)</label>
    <div class="col-md-9">
        <input type="file" name="ProductImages1" class="admin-input" accept="image/*" multiple />
        <small class="text-muted">Chọn đồng thời nhiều ảnh phụ cho khung gallery.</small>
    </div>
</div>

<!-- Mô tả -->
<div class="mb-3 row">
    <label class="col-md-3 col-form-label admin-label">Mô tả sản phẩm</label>
    <div class="col-md-9">
        @Html.TextAreaFor(model => model.Description, 5, 40, new { @class = "admin-textarea", placeholder = "Nhập thông tin chi tiết..." })
        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger text-sm" })
    </div>
</div>