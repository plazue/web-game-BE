@model template.Models.Category

<style>
    /* CSS riêng cho Partial View Category Form */
    .form-container {
        padding: 20px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 4px;
        margin-bottom: 20px;
    }

        .form-container h4 {
            background-color: #dff0d8;
            padding: 12px 15px;
            font-weight: bold;
            color: #333;
            border: 1px solid #d6e9c6;
            margin: -20px -20px 20px -20px;
            font-size: 16px;
        }

    .form-horizontal .control-label {
        font-weight: 600;
        color: #333;
        padding-top: 7px;
    }

    .form-horizontal .form-control {
        border-radius: 4px;
        border: 1px solid #ccc;
        box-shadow: inset 0 1px 1px rgba(0,0,0,.075);
    }

    .form-horizontal .form-group {
        margin-bottom: 15px;
    }
</style>

<div class="form-container">
    <div class="form-horizontal">
        <h4>THÔNG TIN DANH MỤC</h4>
        <hr style="margin-top: 0; border-color: #eee;" />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.CategoryName, "Tên danh mục", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên danh mục..." } })
                @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Slug, "Đường dẫn (Slug)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Slug, new { htmlAttributes = new { @class = "form-control", placeholder = "nhap-duong-dan-slug..." } })
                @Html.ValidationMessageFor(model => model.Slug, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
</div>