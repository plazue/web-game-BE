@{
    ViewBag.Title = "Thành công";
    Layout = "~/Views/Home/mau1.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt hàng thành công - Phong Cách Xanh</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #f5f5f7;
            color: #333;
        }

        .success-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .success-card {
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            padding: 40px;
        }

        .success-header {
            text-align: center;
            border-bottom: 1px solid #eee;
            padding-bottom: 30px;
            margin-bottom: 30px;
        }

        .check-icon {
            width: 70px;
            height: 70px;
            background-color: #22c55e;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin: 0 auto 20px;
            box-shadow: 0 4px 10px rgba(34, 197, 94, 0.3);
        }

        .success-title {
            font-size: 26px;
            font-weight: 700;
            color: #111;
            margin-bottom: 8px;
        }

        .order-number {
            font-size: 15px;
            color: #666;
        }

            .order-number span {
                font-weight: 600;
                color: #2b78a2;
            }

        .section-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            color: #111;
        }

        .order-details {
            margin-bottom: 30px;
        }

        .product-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 0;
            border-bottom: 1px dashed #eee;
        }

            .product-item:last-child {
                border-bottom: none;
            }

        .product-img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #e1e1e1;
        }

        .product-info {
            flex: 1;
        }

        .product-name {
            font-size: 14px;
            font-weight: 600;
            color: #222;
        }

        .product-qty {
            font-size: 13px;
            color: #777;
            margin-top: 4px;
        }

        .product-price {
            font-size: 14px;
            font-weight: 600;
            color: #111;
        }

        .summary-box {
            background-color: #fafafa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            margin-bottom: 10px;
            color: #555;
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: 700;
            color: #111;
            border-top: 1px solid #e1e1e1;
            padding-top: 12px;
            margin-top: 10px;
        }

        .actions {
            text-align: center;
            margin-top: 30px;
        }

        .btn-home {
            display: inline-block;
            background-color: #2b78a2;
            color: #fff;
            padding: 14px 28px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            transition: background-color 0.2s;
        }

            .btn-home:hover {
                background-color: #1f5777;
            }
    </style>
</head>
<body>

    <div class="success-container">
        <div class="success-card">

            <div class="success-header">
                <div class="check-icon">
                    <i class="fa-solid fa-check"></i>
                </div>
                <h1 class="success-title">Đặt hàng thành công!</h1>
                <p class="order-number">Mã đơn hàng: <span id="orderCode">#PCX-0000</span></p>
                <p style="font-size: 14px; color: #666; margin-top: 8px;">Cảm ơn bạn đã mua sắm tại Phong Cách Xanh. Chúng tôi sẽ liên hệ sớm nhất để giao hàng.</p>
            </div>

            <div class="order-details">
                <h2 class="section-title">Chi tiết đơn hàng</h2>
                <div id="productList">
                    <!-- Danh sách sản phẩm từ localStorage -->
                </div>

                <div class="summary-box">
                    <div class="summary-row">
                        <span>Tổng phụ:</span>
                        <span id="subtotalText">0 ₫</span>
                    </div>
                    <div class="summary-row">
                        <span>Phí vận chuyển:</span>
                        <span>Miễn phí</span>
                    </div>
                    <div class="summary-total">
                        <span>Tổng thanh toán:</span>
                        <span id="grandTotalText">0 ₫</span>
                    </div>
                </div>
            </div>

            <div class="actions">
                <a href="/Home/Index" class="btn-home">
                    <i class="fa-solid fa-house"></i> Tiếp tục mua hàng
                </a>
            </div>

        </div>
    </div>

    <script>
                document.addEventListener("DOMContentLoaded", function () {
                    // Đọc dữ liệu từ "lastOrder" để hiển thị đúng sản phẩm và tổng tiền
                    const lastOrder = JSON.parse(localStorage.getItem("lastOrder"));

                    if (lastOrder && lastOrder.items) {
                        // Hiển thị mã đơn hàng
                        if (lastOrder.orderId) {
                            document.getElementById("orderCode").innerText = "#PCX-" + lastOrder.orderId;
                        }

                        // Render danh sách sản phẩm
                        let html = "";
                        lastOrder.items.forEach(item => {
                            let priceNum = Number(item.price) || 0;
                            let qty = Number(item.quantity) || 1;
                            let itemTotal = priceNum * qty;

                            html += `
                                <div class="product-item">
                                    <img src="${item.image || 'https://via.placeholder.com/60'}" class="product-img" alt="${item.title}">
                                    <div class="product-info">
                                        <div class="product-name">${item.title}</div>
                                        <div class="product-qty">Số lượng: ${qty}</div>
                                    </div>
                                    <div class="product-price">${itemTotal.toLocaleString('vi-VN')} ₫</div>
                                </div>
                            `;
                        });

                        document.getElementById("productList").innerHTML = html;

                        let subtotalFormatted = (lastOrder.subtotal || 0).toLocaleString('vi-VN') + " ₫";
                        document.getElementById("subtotalText").innerText = subtotalFormatted;
                        document.getElementById("grandTotalText").innerText = subtotalFormatted;

                        // Xoá giỏ hàng tạm sau khi đã hiển thị thành công
                        localStorage.removeItem("cart");
                        localStorage.removeItem("checkoutData");
                    } else {
                        document.getElementById("productList").innerHTML = "<p style='text-align:center; color:#888; padding:15px;'>Không tìm thấy thông tin đơn hàng.</p>";
                    }
                });
    </script>

</body>
</html>